# ---------------------------------------------------------------
# Copiar este archivo como ".env" y cambiar TODOS los valores marcados.
# Nunca subir el archivo ".env" al repositorio.
# ---------------------------------------------------------------

# Servidor
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Origenes permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173
# true solo si hay un proxy/balanceador delante (para leer la IP real)
TRUST_PROXY=false

# Base de datos (SQL Server). Con docker compose, DB_HOST se sobreescribe a "db".
DB_HOST=localhost
DB_PORT=1433
DB_NAME=OpaCreditos
DB_USER=sa
# Minimo 8 caracteres con mayusculas, minusculas, numeros y simbolos (regla de SQL Server)
DB_PASSWORD=CambiarEstaClave_123
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Autenticacion JWT (en produccion: minimo 32 caracteres aleatorios)
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-0123456789
JWT_EXPIRES_IN=1h

# Usuarios iniciales: se crean al arrancar SOLO si la tabla Usuarios esta vacia.
# Usuarios: "admin" (rol ADMIN) y "analista" (rol ANALISTA). Minimo 8 caracteres.
SEED_ADMIN_PASSWORD=CambiarAdmin_123
SEED_ANALISTA_PASSWORD=CambiarAnalista_123

# Webhook. Por defecto apunta al receptor de demostracion de esta misma API.
# Dejar WEBHOOK_URL vacio para desactivar el envio (los eventos igual se guardan).
WEBHOOK_URL=http://localhost:3000/api/webhooks/demo-receptor
# Secreto compartido para firmar (HMAC-SHA256). Minimo 16 caracteres.
WEBHOOK_SECRET=cambiar-secreto-hmac-del-webhook
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_POLL_INTERVAL_MS=5000
WEBHOOK_BACKOFF_BASE_MS=30000
WEBHOOK_BACKOFF_MAX_MS=3600000
WEBHOOK_BATCH_SIZE=10
# true: el worker corre dentro del proceso de la API (comodo en desarrollo).
# false: ejecutarlo aparte con "npm run worker" (recomendado en produccion).
WORKER_EMBEDDED=true
# Receptor de demostracion del webhook. Se desactiva por defecto en produccion.
ENABLE_DEMO_RECEIVER=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
